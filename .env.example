# =============================================================================
# claude-gmail-cleaner — environment configuration
#
# Copy this file to `.env` and fill in your values. Every variable here is
# optional; the script runs with sensible defaults if `.env` is absent.
# =============================================================================

# --- GCP quota project override ----------------------------------------------
# Routes Gmail API quota to a different project than the one that owns your
# OAuth client. Useful if your primary project is stuck in a billing-frozen
# state. Leave unset to use the OAuth client's own project.
#
# GOOGLE_WORKSPACE_PROJECT_ID=your-quota-project-id

# --- Model Armor (optional response sanitization) ----------------------------
# Path to a Model Armor template that scans gws CLI responses for prompt
# injection. Requires Model Armor API enabled and billing active on the
# project hosting the template. If unset or left as the placeholder, the
# script logs a warning and proceeds — header-only reads remain the primary
# safety mechanism.
#
# GOOGLE_WORKSPACE_CLI_SANITIZE_TEMPLATE=projects/YOUR_PROJECT_ID/locations/us-central1/templates/YOUR_TEMPLATE_ID
#
# How to handle responses flagged by Model Armor:
#   warn  — return responses but annotate findings (gws default)
#   block — refuse to return flagged responses (recommended)
#
# GOOGLE_WORKSPACE_CLI_SANITIZE_MODE=block

# --- Run-tuning knobs --------------------------------------------------------
# Cap total messages processed in a single fetch run. Useful while iterating
# on the pipeline against a large mailbox. Omit (or set to 0) for no cap.
#
# CLEANUP_MAX_MESSAGES=2000

# Number of concurrent in-flight gws header requests. Default: 8. Raise if
# you have a fast connection and want shorter wall-clock; lower if you hit
# Gmail rate limits.
#
# CLEANUP_CONCURRENCY=8

# How many years back to bucket messages in `pnpm baseline`. Default: 10.
#
# CLEANUP_YEAR_LOOKBACK=10

# Per-batch wall-clock estimate used in plan ETA. Default: 2 seconds.
#
# CLEANUP_SECONDS_PER_BATCH=2

# Number of top senders displayed in cleanup_plan.md tables. Default: 25.
#
# PLAN_TOP_N=25
